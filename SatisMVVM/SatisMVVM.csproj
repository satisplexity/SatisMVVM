<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<IsPackable>true</IsPackable>
		<PackageId>SatisMVVM</PackageId>
		<Version>0.0.1</Version>
		<Authors>satisplexity</Authors>

		<Description>
			A lightweight MVVM library with observable objects,
			relay commands, asynchronous commands and navigation.
		</Description>

		<PackageTags>mvvm;commands;navigation;dotnet</PackageTags>
		<PackageProjectUrl>https://github.com/satisplexity/SatisMVVM</PackageProjectUrl>
		<RepositoryUrl>https://github.com/satisplexity/SatisMVVM</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference
		  Include="Microsoft.Extensions.DependencyInjection"
		  Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<None Include="../README.md"
			  Pack="true"
			  PackagePath="/" />
	</ItemGroup>

</Project>